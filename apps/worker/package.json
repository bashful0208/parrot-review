{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.dev.json src/index.ts",
    "build": "pnpm --dir ../../packages/core run build && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --tsconfig tsconfig.dev.json --test src/**/*.test.ts src/**/*.integration.test.ts",
    "lint": "pnpm --dir ../.. exec eslint .",
    "typecheck": "pnpm --dir ../../packages/core run build && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@langchain/langgraph-checkpoint-postgres": "^1.0.1",
    "@reviewer/ai": "workspace:*",
    "@reviewer/core": "workspace:*",
    "@reviewer/git": "workspace:*",
    "bullmq": "^5.58.0",
    "ioredis": "^5.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
