SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
WEBHOOK_SECRET=replace-with-webhook-secret
# DEFAULT_MODEL_PROVIDER / DEFAULT_MODEL_NAME are still required by web startup today.
# They are only legacy env fallbacks for packages/ai, and worker startup no longer depends on them.
DEFAULT_MODEL_PROVIDER=anthropic
DEFAULT_MODEL_NAME=claude-3-7-sonnet
REDIS_URL=redis://127.0.0.1:6379
REVIEW_QUEUE_NAME=review-jobs
