DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/reviewer
# Webhook secrets are per-repository: each onboarded repo gets its own secret
# stored in repo_integrations.metadata.webhook_secret and shown in the UI.
# DEFAULT_MODEL_PROVIDER / DEFAULT_MODEL_NAME are still required by web startup today.
# They remain legacy env fallbacks for packages/ai, and worker startup no longer depends on them.
DEFAULT_MODEL_PROVIDER=anthropic
DEFAULT_MODEL_NAME=claude-3-7-sonnet
REDIS_URL=redis://127.0.0.1:6379
REVIEW_QUEUE_NAME=review-jobs
